{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "\t$0",
      "}"
    ],
    "description": "Function declaration"
  },
  "Function with types": {
    "prefix": "fnt",
    "body": [
      "fn ${1:name}(${2:x}: ${3:int}): ${4:int} {",
      "\t$0",
      "}"
    ],
    "description": "Function with type annotations"
  },
  "Function returning an error": {
    "prefix": "fne",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "\tif ${3:!ok} {",
      "\t\treturn nil, error(\"${4:failed}\")",
      "\t}",
      "\treturn ${5:value}, nil",
      "}"
    ],
    "description": "Function that returns value, error"
  },
  "Arrow function": {
    "prefix": "arrow",
    "body": [
      "(${1:x}) => ${0:x}"
    ],
    "description": "Arrow function"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field} = ${3:0}",
      "",
      "\tnew(${2:field}) {",
      "\t\tthis.${2:field} = ${2:field}",
      "\t}",
      "",
      "\tfn ${4:method}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Struct with a constructor and a method"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\tfn ${2:method}(): ${3:str}",
      "}"
    ],
    "description": "Interface (structural)"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "if statement"
  },
  "If else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:0} => ${3:\"zero\"}",
      "\t_ => ${0:\"other\"}",
      "}"
    ],
    "description": "match expression (must be exhaustive)"
  },
  "For range": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t$0",
      "}"
    ],
    "description": "for over a half-open range"
  },
  "For each": {
    "prefix": "foreach",
    "body": [
      "for ${1:i}, ${2:item} in ${3:items} {",
      "\t$0",
      "}"
    ],
    "description": "for with index and item (or key and value)"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "\t$0",
      "\tif ${1:done} { break }",
      "}"
    ],
    "description": "loop until break/return"
  },
  "Task": {
    "prefix": "fg",
    "body": [
      "fg fn(${1:n}) {",
      "\t$0",
      "}(${2:arg})"
    ],
    "description": "Start a cooperative task"
  },
  "Channel": {
    "prefix": "chan",
    "body": [
      "const ${1:ch} = chan(${2:10})"
    ],
    "description": "Buffered channel"
  },
  "Select": {
    "prefix": "select",
    "body": [
      "select {",
      "\tcase ${1:v} = <-${2:ch}: ${3:print($1)}",
      "\tcase <-timeout(${4:1s}): ${0:print(\"timed out\")}",
      "}"
    ],
    "description": "select over channels with a timeout"
  },
  "Import module": {
    "prefix": "import",
    "body": [
      "import ${1:json} from \"fogu:${1:json}\""
    ],
    "description": "Import a standard library module"
  },
  "Import names": {
    "prefix": "importn",
    "body": [
      "import { ${2:name} } from \"${1:./module.fg}\""
    ],
    "description": "Named import"
  },
  "Handle error": {
    "prefix": "err",
    "body": [
      "const [${1:value}, err] = ${2:call()}",
      "if err != nil {",
      "\t${0:print(\"failed:\", err.message)}",
      "}"
    ],
    "description": "const [v, err] = … with an error check"
  },
  "Return error": {
    "prefix": "reterr",
    "body": [
      "if err != nil {",
      "\treturn nil, err",
      "}"
    ],
    "description": "Propagate an error"
  },
  "Template string": {
    "prefix": "tpl",
    "body": [
      "`${1:text} \\${${2:expr}}`"
    ],
    "description": "Template string with interpolation"
  },
  "HTTP server": {
    "prefix": "server",
    "body": [
      "import web from \"fogu:web\"",
      "",
      "const app = web.app()",
      "app.get(\"/${1:hello}/:name\", (ctx) => ({ ${1:hello}: ctx.params.name }))",
      "app.listen(${2:8080})?",
      "print(\"listening on http://127.0.0.1:${2:8080}\")",
      "Fogu.signal.wait()"
    ],
    "description": "Web server with fogu:web (served until Ctrl+C)"
  },
  "HTTP GET": {
    "prefix": "httpget",
    "body": [
      "import http from \"fogu:http\"",
      "",
      "const res = http.get(\"${1:https://example.com}\")?",
      "print(res.status, ${0:res.json()})"
    ],
    "description": "HTTP request with fogu:http"
  },
  "Test file": {
    "prefix": "testfile",
    "body": [
      "import { test, expect } from \"fogu:test\"",
      "",
      "test(\"${1:does something}\", () => {",
      "\texpect(${2:1 + 1}).toBe(${3:2})",
      "})"
    ],
    "description": "Test file skeleton (name it *.test.fg, run with fogu test)"
  },
  "Test case": {
    "prefix": "test",
    "body": [
      "test(\"${1:name}\", () => {",
      "\texpect(${2:value}).${3:toBe}(${4:expected})$0",
      "})"
    ],
    "description": "A test case"
  },
  "Expect": {
    "prefix": "expect",
    "body": [
      "expect(${1:value}).${2|toBe,toEqual,toBeTruthy,toBeFalsy,toBeNil,toBeError,toContain,toHaveLength|}(${3})"
    ],
    "description": "Expectation"
  },
  "Read file": {
    "prefix": "readfile",
    "body": [
      "import fs from \"fogu:fs\"",
      "",
      "const ${1:text} = fs.readText(\"${2:file.txt}\")?"
    ],
    "description": "Read a text file"
  },
  "Main guard": {
    "prefix": "wait",
    "body": [
      "Fogu.signal.wait()"
    ],
    "description": "Keep the program alive until Ctrl+C / SIGTERM"
  },
  "Exported function": {
    "prefix": "efn",
    "body": [
      "export fn ${1:name}(${2:x}: ${3:int}): ${4:int} {",
      "\t$0",
      "}"
    ],
    "description": "Exported function with types (import { name } from \"./file.fg\")"
  },
  "Exported constant": {
    "prefix": "econst",
    "body": [
      "export const ${1:NAME}: ${2:int} = ${0:0}"
    ],
    "description": "Exported constant with its type"
  },
  "Exported struct": {
    "prefix": "estruct",
    "body": [
      "export struct ${1:Name} {",
      "\t${2:field}: ${3:int} = ${4:0}",
      "",
      "\tnew(${2:field}: ${3:int}) {",
      "\t\tthis.${2:field} = ${2:field}",
      "\t}",
      "",
      "\t${5:method}(): ${6:str} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Exported struct with typed fields, constructor and method"
  },
  "Exported interface": {
    "prefix": "einterface",
    "body": [
      "export interface ${1:Name} {",
      "\t${2:method}(${3:x}: ${4:int}): ${5:str}",
      "}"
    ],
    "description": "Exported interface (structural)"
  },
  "Export list": {
    "prefix": "export",
    "body": [
      "export { ${1:name}${2:, ${3:other} as ${4:alias}} }"
    ],
    "description": "Export names declared above"
  },
  "Export default": {
    "prefix": "edefault",
    "body": [
      "export default ${0:name}"
    ],
    "description": "Default export of the file"
  },
  "Re-export": {
    "prefix": "reexport",
    "body": [
      "export * from \"./${1:file}.fg\""
    ],
    "description": "Re-export from another file"
  },
  "Import from file": {
    "prefix": "importf",
    "body": [
      "import { ${2:name} } from \"./${1:file}.fg\""
    ],
    "description": "Import names from a file of the project"
  },
  "Import file as module": {
    "prefix": "importa",
    "body": [
      "import * as ${2:mod} from \"./${1:file}.fg\""
    ],
    "description": "Import a file as a module object"
  },
  "Import default and names": {
    "prefix": "importd",
    "body": [
      "import ${2:Default}, { ${3:name} } from \"./${1:file}.fg\""
    ],
    "description": "Import the default export and names"
  },
  "Typed variable": {
    "prefix": "lett",
    "body": [
      "let ${1:name}: ${2|int,float,str,bool,char,any,list<int>,map<str\\, any>,u8,i32,f64|} = ${0:value}"
    ],
    "description": "Variable with a type annotation"
  },
  "Any": {
    "prefix": "any",
    "body": [
      "let ${1:value}: any = ${0:nil}"
    ],
    "description": "A variable that holds any value"
  },
  "Sized list": {
    "prefix": "sized",
    "body": [
      "let ${1:data}: list<${2|u8,i8,u16,i16,u32,i32,u64,i64,f32,f64,char|}> = [${0}]"
    ],
    "description": "A list stored with the size of its elements (1 byte per u8, 4 per i32/f32/char, 8 per i64/f64)"
  },
  "Interface with implementation": {
    "prefix": "impl",
    "body": [
      "interface ${1:Shape} {",
      "\t${2:area}(): ${3:float}",
      "}",
      "",
      "struct ${4:Square} {",
      "\t${5:side}: ${3:float} = ${6:1.0}",
      "",
      "\t${2:area}(): ${3:float} {",
      "\t\treturn ${0:this.${5:side} * this.${5:side}}",
      "\t}",
      "}",
      "",
      "fn ${7:show}(s: ${1:Shape}) {",
      "\tprint(s.${2:area}())",
      "}"
    ],
    "description": "An interface, a struct that satisfies it and a function that takes it"
  },
  "Struct with embed": {
    "prefix": "embed",
    "body": [
      "struct ${1:Name} {",
      "\tembed ${2:Base}",
      "\t${3:field} = ${4:0}",
      "}"
    ],
    "description": "Struct that embeds another (its fields and methods become available)"
  },
  "Generic function": {
    "prefix": "fng",
    "body": [
      "fn ${1:name}<T>(${2:items}: list<T>): ${3:T} {",
      "\t$0",
      "}"
    ],
    "description": "Generic function"
  },
  "Value and error": {
    "prefix": "verr",
    "body": [
      "const [${1:value}, ${2:err}] = ${3:call()}",
      "if ${2:err} != nil {",
      "\t${0:return nil, ${2:err}}",
      "}"
    ],
    "description": "Split a value/error result and handle the error"
  },
  "Try operator": {
    "prefix": "try",
    "body": [
      "const ${1:value} = ${2:call()}?"
    ],
    "description": "Propagate an error to the caller with ?"
  },
  "Worker": {
    "prefix": "worker",
    "body": [
      "import sync from \"fogu:sync\"",
      "",
      "fn ${1:work}(${2:n}) {",
      "\treturn ${3:n * 2}",
      "}",
      "",
      "const ${4:w} = sync.Worker(${1:work})?",
      "print(${4:w}.call(${5:21})?)",
      "${4:w}.close()"
    ],
    "description": "A worker: another OS thread with its own interpreter (values cross as JSON)"
  },
  "Program arguments": {
    "prefix": "args",
    "body": [
      "const ${1:args} = Fogu.args"
    ],
    "description": "Arguments after the script name (Fogu.args)"
  },
  "Environment variable": {
    "prefix": "env",
    "body": [
      "const ${1:value} = Fogu.env.${2:NAME} ?? \"${3:default}\""
    ],
    "description": "An environment variable with a default (Fogu.env)"
  },
  "Exit": {
    "prefix": "exit",
    "body": [
      "Fogu.exit(${1:1})"
    ],
    "description": "End the program with a status code"
  },
  "Re-export names": {
    "prefix": "reexportn",
    "body": [
      "export { ${2:name} } from \"./${1:file}.fg\""
    ],
    "description": "Re-export names from another file"
  },
  "Describe with hooks": {
    "prefix": "describe",
    "body": [
      "describe(\"${1:group}\", () => {",
      "\tbeforeAll(() => {",
      "\t\t${2:// once, before the tests of the group}",
      "\t})",
      "\tbeforeEach(() => {",
      "\t\t${3:// before each test}",
      "\t})",
      "\tafterEach(() => {",
      "\t\t${4:// after each test, also when it failed}",
      "\t})",
      "\tafterAll(() => {",
      "\t\t${5:// once, after the tests of the group}",
      "\t})",
      "",
      "\ttest(\"${6:does something}\", () => {",
      "\t\texpect(${7:value}).toBe(${8:expected})$0",
      "\t})",
      "})"
    ],
    "description": "A group of tests with its hooks (fogu:test)"
  },
  "Test each": {
    "prefix": "testeach",
    "body": [
      "test.each([",
      "\t[${1:2}, ${2:3}, ${3:5}],",
      "\t[${4:10}, ${5:20}, ${6:30}],",
      "])(\"${7:add(%d, %d) = %d}\", (${8:a}, ${9:b}, ${10:expected}) => {",
      "\texpect(${11:a + b}).toBe(${10:expected})$0",
      "})"
    ],
    "description": "One test per row (fogu:test)"
  },
  "Read stream": {
    "prefix": "readstream",
    "body": [
      "const ${1:lines} = fs.createReadStream(\"${2:file.txt}\", { lines: true })?",
      "for ${3:line} in ${1:lines} {",
      "\t$0",
      "}",
      "if ${1:lines}.error != nil { return nil, ${1:lines}.error }"
    ],
    "description": "Read a file a line at a time (fogu:fs)"
  },
  "Write stream": {
    "prefix": "writestream",
    "body": [
      "const ${1:out} = fs.createWriteStream(\"${2:out.txt}\")?",
      "${1:out}.writeLine(${3:\"text\"})?",
      "${1:out}.close()"
    ],
    "description": "Write a file a piece at a time (fogu:fs)"
  },
  "Response stream": {
    "prefix": "webstream",
    "body": [
      "app.get(\"${1:/export}\", (ctx) => {",
      "\tconst ${2:out} = web.stream({ contentType: \"${3:text/plain}\" })",
      "\tfg fn() {",
      "\t\t${0:${2:out}.writeLine(\"line\")?}",
      "\t\t${2:out}.end()",
      "\t}()",
      "\treturn ${2:out}",
      "})"
    ],
    "description": "A response written a piece at a time, with backpressure (fogu:web)"
  },
  "Value stream": {
    "prefix": "stream",
    "body": [
      "import stream from \"fogu:stream\"",
      "",
      "const ${1:s} = stream.create({ buffer: ${2:16} })",
      "fg fn() {",
      "\tfor ${3:i} in 0..${4:100} { ${1:s}.write(${3:i})? }",
      "\t${1:s}.close()",
      "}()",
      "for ${5:v} in ${1:s}.map((x) => ${6:x * 2}).take(${7:10}) {",
      "\t$0",
      "}"
    ],
    "description": "A stream written by a task and consumed lazily (fogu:stream)"
  }
}
