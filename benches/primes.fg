fn is_prime(n) {
    if n < 2 { return false }
    let i = 2
    while i * i <= n {
        if n % i == 0 { return false }
        i += 1
    }
    return true
}
let t0 = clock()
let count = 0
for n in 0..300000 {
    if is_prime(n) { count += 1 }
}
print("primes < 300000:", count)
print("time:", clock() - t0, "s")
