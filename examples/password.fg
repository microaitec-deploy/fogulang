// Password storage with fogu:password: register, log in, upgrade old hashes.
// Run: fogu examples/password.fg
import password from "fogu:password"

// one policy for hash, verify and needsRehash; the pepper would come from the
// environment or a secret store in a real application (never from the database)
const policy = { algorithm: "argon2id", memory: 19456, time: 2, parallelism: 1, pepper: "demo-pepper" }

const users = {}

fn register(name: str, pw: str) {
    const s = password.strength(pw, [name])
    if s.score < 3 {
        return error("password too weak: " + (s.warning ?? s.suggestions.join(" ")))
    }
    users[name] = password.hash(pw, policy)?
    return nil
}

fn login(name: str, pw: str) {
    const stored = users[name]
    if stored == nil { return false }
    if !password.verify(pw, stored, policy)? { return false }
    // stored with older or weaker settings: re-hash now that we know the password
    if password.needsRehash(stored, policy)? {
        users[name] = password.hash(pw, policy)?
        print("  (upgraded the hash of", name + ")")
    }
    return true
}

print("register ana (weak):", register("ana", "ana2024"))
const pw = password.passphrase(5)
print("register ana:", register("ana", pw))
print("login ok:", login("ana", pw))
print("login wrong:", login("ana", "nope"))

// an old bcrypt hash from a previous system gets upgraded on the next login
users["bob"] = password.hash("old secret 1", { algorithm: "bcrypt", cost: 10, pepper: "demo-pepper" })?
print("bob:", password.info(users["bob"])?.algorithm)
print("login bob:", login("bob", "old secret 1"))
print("bob now:", password.info(users["bob"])?.algorithm)

print("a random password:", password.generate(20, { excludeAmbiguous: true }))
