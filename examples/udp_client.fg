import net from "fogu:net"

// Run examples/udp_server.fg first.
let cli = net.udpBind("127.0.0.1:0")?
print("local socket at", cli.addr)

cli.sendTo("127.0.0.1:9001", "ping 1")
let r = cli.recvFrom()
if typeof(r) == "error" {
    // no server: the network error is a value
    print("no reply:", r)
} else {
    print("reply:", r.text, "(from", r.from, ")")
}

cli.close()
