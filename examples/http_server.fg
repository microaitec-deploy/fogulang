import http from "fogu:http"

http.serve(3000, fn(req) {
    if req.path == "/ping" {
        return http.text("pong")
    }
    if req.path == "/health" {
        return http.json({
            status: "ok",
            service: "fogu-http"
        })
    }
    return http.text("not found", { status: 404 })
})

print("server at http://127.0.0.1:3000")
print("Ctrl+C to stop")

// Keeps the process alive: requests are handled while the program waits.
Fogu.signal.wait()    // serves requests until Ctrl+C / SIGTERM
