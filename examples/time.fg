import time from "fogu:time"

// `Date()` returns an object with the current instant
let now = time.Date()

print("getFullYear:", now.getFullYear())
print("getMonth (0-11):", now.getMonth())
print("getDate:", now.getDate())
print("getDay (0=Sun):", now.getDay())
print("getHours:", now.getHours())
print("getMinutes:", now.getMinutes())
print("getSeconds:", now.getSeconds())
print("getMilliseconds:", now.getMilliseconds())
print("getTime:", now.getTime())
print("toISOString:", now.toISOString())
print("toString:", now.toString())

// Direct properties too
print("year:", now.year, "month:", now.month, "day:", now.day)

// Current timestamp in ms
print("now():", time.now())

// delays
print("before")
time.delay(500ms)
print("after delay(500ms)")

time.sleep(0.25)         // 250 ms (in seconds)
print("after sleep(0.25)")

// Difference between two instants
let later = time.Date()
print("diff(ms):", later.diff(now))
