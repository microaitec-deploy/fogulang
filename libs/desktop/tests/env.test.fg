// The library reads the environment when it needs it (process.env), so a test
// or a tool can point it somewhere else with process.setEnv while it runs:
// the data folder, the program folder of update.fg, the hosts of the build.
import { test, expect } from "fogu:test"
import fs from "fogu:fs"
import path from "fogu:path"
import process from "fogu:process"
import desktop from "../main.fg"
import update from "../update.fg"
import tools from "../tools/build.fg"

const tmp = path.join(fs.tempDir(), "fogu-desktop-env-test-" + str(clock()))
fs.mkdir(tmp)?

test("dataDir follows FOGU_DESKTOP_DATA_DIR set while the program runs", () => {
    const a = path.join(tmp, "data-a")
    const b = path.join(tmp, "data-b")
    process.setEnv("FOGU_DESKTOP_DATA_DIR", a)
    expect(desktop.dataDir()).toBe(a)
    expect(fs.isDir(a)).toBe(true)
    process.setEnv("FOGU_DESKTOP_DATA_DIR", b)
    expect(desktop.dataDir()).toBe(b)
    expect(fs.isDir(b)).toBe(true)
})

test("keep / kept follow FOGU_DESKTOP_KEPT", () => {
    const file = path.join(tmp, "kept.json")
    process.setEnv("FOGU_DESKTOP_KEPT", file)
    desktop.keep("n", 7)?
    expect(fs.readText(file)?).toBe("{\"n\":7}")
    expect(desktop.kept("n")).toBe(7)
    const other = path.join(tmp, "kept-2.json")
    fs.writeText(other, "{\"n\":9}")?
    process.setEnv("FOGU_DESKTOP_KEPT", other)
    expect(desktop.kept("n")).toBe(9)
})

test("update reads fogu.json of FOGU_DESKTOP_PROGRAM_DIR set while the program runs", () => {
    const a = path.join(tmp, "app-a")
    const b = path.join(tmp, "app-b")
    fs.mkdir(a)?
    fs.mkdir(b)?
    fs.writeText(path.join(a, "fogu.json"), "{ \"name\": \"a\", \"version\": \"1.0.0\" }")?
    fs.writeText(path.join(b, "fogu.json"), "{ not json")?
    process.setEnv("FOGU_DESKTOP_PROGRAM_DIR", a)
    const [_x, e1] = update.check()
    expect(e1.message).toContain("\"endpoint\", \"pubkey\"")
    process.setEnv("FOGU_DESKTOP_PROGRAM_DIR", b)
    const [_y, e2] = update.check()
    expect(e2.message).toContain("update: fogu.json:")
})

test("the build reads FOGU_HOME and FOGU_DESKTOP_HOSTS when it is called", () => {
    process.setEnv("FOGU_HOME", path.join(tmp, "home-1"))
    expect(tools.home()).toBe(path.join(tmp, "home-1"))
    process.setEnv("FOGU_HOME", path.join(tmp, "home-2"))
    expect(tools.home()).toBe(path.join(tmp, "home-2"))
    process.setEnv("FOGU_DESKTOP_HOSTS", path.join(tmp, "hosts"))
    expect(tools.prebuiltRoots(tools.libRoot())[0]).toBe(path.join(tmp, "hosts"))
    fs.removeAll(tmp)
})
