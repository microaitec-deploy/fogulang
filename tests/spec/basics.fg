// Types, literals, arithmetic and conversions (spec §7, §8, §10, §11)
print(typeof(42), typeof(3.14), typeof("s"), typeof(true), typeof(nil))
print(1_000_000, 0xff, 0b1010, 1e3, 2.5e-1)
print(2 + 3, 10 - 4, 6 * 7, 20 / 4, 7 / 2, 17 % 5, 2 ** 10, 1 + 2.5)
print(-2 ** 2, 2 ** 3 ** 2)
print(int("123") + 1, float(10), str(42), int(3.9))
print("a" + "b", 'single', "esc\"ape\tx")
print(3 < 5, 3 >= 5, "abc" == "abc", [1, 2] == [1, 2], {a: 1} == {a: 1})
print(true && false, true || false, !false)
print(nil ?? "default", 0 ?? 1)
// truthiness: only false and nil are falsy
for v in [0, "", [], {}, false, nil] {
    if v { print("truthy") } else { print("falsy") }
}
let x = 10
x += 5
x *= 2
x -= 1
x %= 7
print(x)
