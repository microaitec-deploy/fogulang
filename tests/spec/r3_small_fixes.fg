// Small fixes of 0.8.4.
import json from "fogu:json"
import html from "fogu:html"
import http from "fogu:http"

// json.stringify: `strict` turns what JSON cannot hold into an error
print(json.stringify({ n: 0.0 / 0.0, i: 1.0 / 0.0 })?)
print(json.stringify({ n: 0.0 / 0.0 }, { strict: true }))
print(json.stringify({ f: (x) => x }, { strict: true }))
print(json.stringify({ a: [1, 2.5, "x"] }, { strict: true })?)

// html.fromMarkdown: `sanitize` for text that is not the program's own
print(html.fromMarkdown("<script>alert(1)</script>**b**").trim())
print(html.fromMarkdown("<script>alert(1)</script>**b**", { sanitize: true }).trim())

// maxBody: a number of bytes or a size written out
http.serve(18543, (req) => http.text(str(len(req.body))), { quiet: true, maxBody: "1kb" })?
for n in [1024, 1025] {
    const [r, e] = http.post("http://127.0.0.1:18543/", "A".repeat(n))
    print(n, r?.status)
}
http.serve(18544, (req) => http.text("x"), { quiet: true, maxBody: "ten" })
