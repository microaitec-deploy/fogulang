import types from "fogu:types"
import time from "fogu:time"

struct User {
    name = ""
    age = 0
}

// predicates and names
print(types.isInt(3), types.isInt(3.0), types.isNumber(3.0), types.isStr("a"), types.isNil(nil))
print(types.isList([]), types.isMap({}), types.isFn(print), types.isEmpty(""), types.isEmpty([1]))
print(types.of(1), types.of("x"), types.of(new User()), types.of(time.Date(0)), types.of(nil))

// lenient conversions: an error value, or the default given
print(types.toInt("42"), types.toInt(" 0x1F "), types.toInt("1_000"), types.toInt(7.0), types.toInt(true))
const [_, e1] = types.toInt("4.5")
print(e1.message)
print(types.toInt("abc", -1), types.toFloat("2.5"), types.toBool("yes"), types.toBool("off"), types.toStr(12))
print(types.toList("abc"), types.toList(1..4), types.toMap([["a", 1], ["b", 2]]), types.toMap(new User()))

// schemas
const UserSpec = {
    name: { "$type": "str", minLen: 1 },
    "age?": { "$type": "int", min: 0, max: 150 },
    email: { "$type": "str", pattern: "[^@]+@[^@]+" },
    tags: "[str]",
    role: { "$type": "str", oneOf: ["admin", "user"] },
}
const good = { name: "Ana", email: "ana@x.io", tags: ["a"], role: "user" }
print(types.is(good, UserSpec), types.check(good, UserSpec)?.name)
const bad = { name: "", age: 200, email: "nope", tags: ["a", 2], role: "root" }
const [_, e2] = types.check(bad, UserSpec)
print(e2.message)
for p in types.validate(bad, UserSpec) { print(" -", p) }
print(types.validate({}, { id: "int" }), types.is(5, "int|str"), types.is(nil, "str?"), types.is([1, "a"], "[int]"))
print(types.is({ a: 1, b: 2 }, "{int}"), types.is(new User(), "User"), types.is(time.Date(0), "Date"))
print(types.validate({ a: 1, x: 2 }, { "$type": "map", fields: { a: "int" }, strict: true }))

// coerce: texts become the numbers and bools the spec asks for
const q = types.coerce({ page: "2", size: "50", debug: "true", ratio: "0.5", ids: ["1", "2"] },
    { page: "int", size: { "$type": "int", max: 100 }, debug: "bool", ratio: "float", ids: "[int]" })?
print(q)
const [_, e3] = types.coerce({ size: "500" }, { size: { "$type": "int", max: 100 } })
print(e3.message)

// deep equality and copies
const a = { xs: [1, { y: 2 }] }
const b = types.clone(a)
b.xs[1].y = 3
print(types.equal(a, { xs: [1, { y: 2 }] }), types.equal(a, b), a.xs[1].y)
print(types.equal(new User(), new User()))

// schemas in the builder style (as Zod): every method returns a new schema
const Signup = types.object({
    name: types.str().min(1).max(40),
    age: types.int().min(0).max(150).optional(),
    email: types.str().email(),
    tags: types.list(types.str()).max(3).default([]),
    role: types.enum(["admin", "user"]).default("user"),
    site: types.str().url().nullable(),
}, { strict: true })
print(Signup.is({ name: "Ana", email: "ana@x.io", site: nil }))
const [u, perr] = Signup.parse({ name: "Ana", email: "ana@x.io", site: nil })
print(u.name, u.role, u.tags, perr)
const r = Signup.safeParse({ name: "", email: "nope", tags: ["a", "b", "c", "d"], role: "root", extra: 1 })
print(r.ok)
for p in r.errors { print(" -", p) }
const Q = types.object({ page: types.int().default(1), size: types.int().max(100).default(20), debug: types.bool().optional() })
print(Q.coerce({ page: "2", debug: "true" })?)
const Id = types.union([types.int().min(1), types.str().uuid()])
print(Id.is(7), Id.is("x"), Id.is(0))
const [_, uerr] = Id.parse(0)
print(uerr.message)
const Base = types.str()
const Short = Base.max(3)
print(Base.is("hello"), Short.is("hello"), Short.spec())
print(types.is({ a: 1 }, types.map(types.int())), types.validate({ a: "x" }, types.map(types.int())))
print(types.literal("on").is("on"), types.instance("Date").is(time.Date(0)), types.schema("[int]").is([1, 2]))
