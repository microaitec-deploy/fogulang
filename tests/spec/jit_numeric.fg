// Numeric code the JIT compiles: it must give the same as the interpreter.
fn fib(n) {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
print(fib(25))

let total = 0
let i = 0
while i < 100000 {
    total += i % 7
    i += 1
}
print(total)

let f = 0.0
for k in 0..1000 {
    f = f + 1.0 / (k + 1)
}
print(f)

fn collatz(n) {
    let steps = 0
    let x = n
    while x != 1 {
        if x % 2 == 0 { x = x / 2 } else { x = 3 * x + 1 }
        steps += 1
    }
    return steps
}
print(collatz(27))
