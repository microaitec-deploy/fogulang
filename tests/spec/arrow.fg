// Arrow functions (spec §21)
const double = (x) => x * 2
const sum = (a, b) => a + b
const zero = () => 0
const block = (x) => {
    const y = x + 1
    return y * 10
}
print(double(4), sum(2, 3), zero(), block(1))
print([1, 2, 3].map((x) => x * x), [1, 2, 3, 4].filter((x) => x % 2 == 0))
const m = {f: (s) => s.upper(), n: 1}
print(m.f("ok"))
print((1 + 2) * 3)
fn apply(f, v) { return f(v) }
print(apply((v) => `<${v}>`, "x"))
const c = chan(1)
fg () => { c <- "from an arrow" }()
print(<-c)
