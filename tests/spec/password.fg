// fogu:password — hashing, verification, rehash checks, generation, strength
import password from "fogu:password"
import crypto from "fogu:crypto"
import security from "fogu:security"

// low-cost parameters keep the test fast (never use them in production)
const fast = {
    "argon2id": { algorithm: "argon2id", memory: 64, time: 1 },
    "argon2i": { algorithm: "argon2i", memory: 64, time: 1 },
    "argon2d": { algorithm: "argon2d", memory: 64, time: 1 },
    "bcrypt": { algorithm: "bcrypt", cost: 4 },
    "scrypt": { algorithm: "scrypt", n: 16, r: 8, p: 1 },
    "pbkdf2-sha256": { algorithm: "pbkdf2-sha256", iterations: 1000 },
    "pbkdf2-sha512": { algorithm: "pbkdf2-sha512", iterations: 1000 },
}
print(password.algorithms)
for name in password.algorithms {
    const opts = fast[name]
    const h = password.hash("hunter2", opts)?
    print(name, password.info(h)?.algorithm, password.verify("hunter2", h)?, password.verify("hunter3", h)?, password.needsRehash(h, opts)?, password.needsRehash(h)?)
}

// hash formats and info (no secrets)
const a = password.hash("pw", fast["argon2id"])?
print(a.starts_with("$argon2id$v=19$m=64,t=1,p=1$"))
print(password.info(a)?)
const b = password.hash("pw", fast["bcrypt"])?
print(b.starts_with("$2b$04$"), len(b), password.info(b)?)
print(password.info(password.hash("pw", fast["scrypt"])?)?)
print(password.info(password.hash("pw", fast["pbkdf2-sha512"])?)?)

// two hashes of the same password differ (random salt)
print(password.hash("pw", fast["bcrypt"])? != b)

// hashes from other implementations: OpenBSD bcrypt ($2a$) and the defaults
print(password.verify("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")?)
print(password.needsRehash("$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW", { algorithm: "bcrypt", cost: 4 })?)

// upgrades: a stronger request needs a rehash, the same or weaker does not
const weak = password.hash("pw", { algorithm: "argon2id", memory: 64, time: 1 })?
print(password.needsRehash(weak, { memory: 128, time: 1 })?, password.needsRehash(weak, { memory: 32, time: 1 })?)
print(password.needsRehash(b, { algorithm: "bcrypt", cost: 5 })?, password.needsRehash(b, { algorithm: "argon2id" })?)

// the pepper: needed to verify, and it lifts bcrypt's 72-byte limit
const peppered = password.hash("pw", { algorithm: "bcrypt", cost: 4, pepper: "server secret" })?
print(password.verify("pw", peppered, { pepper: "server secret" })?, password.verify("pw", peppered)?, password.verify("pw", peppered, { pepper: "other" })?)
const long = "x".repeat(100)
const [_, tooLong] = password.hash(long, { algorithm: "bcrypt", cost: 4 })
print(tooLong.message)
print(password.verify(long, password.hash(long, { algorithm: "bcrypt", cost: 4, pepper: "k" })?, { pepper: "k" })?)

// malformed hashes are error values
const [_, bad] = password.verify("pw", "not a hash")
print(typeof(bad), bad.message.starts_with("password.verify: not a valid password hash"))
const [_, badInfo] = password.info("$2b$12$short")
print(badInfo.message)
const [_, sha1] = password.info("$pbkdf2$i=1000,l=32$c2FsdHNhbHQ$aGFzaGhhc2hoYXNoaGFzaGhhc2hoYXNoaGFzaGhhc2g")
print(sha1.message)

// crypto.hashPassword / verifyPassword stay argon2id and understand every algorithm
print(crypto.verifyPassword("hunter2", password.hash("hunter2", fast["scrypt"])?), crypto.verifyPassword("nope", b))

// verification runs off the interpreter thread: a task keeps running meanwhile
const done = chan(1)
fg fn() { done <- password.verify("pw", b)? }()
print(<-done)

// random passwords
const p = password.generate()
print(len(p))
const digits = password.generate(12, { upper: false, lower: false, symbols: false })
print(len(digits), digits.chars().all((c) => "0123456789".contains(c)))
const clear = password.generate(64, { symbols: false, excludeAmbiguous: true })
print(clear.chars().any((c) => "Il1O0o".contains(c)))
const custom = password.generate(4, { lower: false, upper: false, digits: false, symbols: "#" })
print(custom)
const phrase = password.passphrase()
print(phrase.split("-").len())
print(password.passphrase(3, " ").split(" ").len())

// strength (zxcvbn when built with the network feature, an entropy estimate otherwise)
const s1 = password.strength("password")
print(s1.score, s1.warning != nil, s1.suggestions.len() > 0)
print(password.strength("correct horse battery staple 9!").score)
print(security.passwordStrength("Tr0ub4dour&3xQ!vZ#82kLp").score)
