// Loops over sized lists are compiled like the ones over ordinary lists
// (the JIT reads and writes the compact storage): the results and the errors
// are the interpreter's. Long loops, so that they are compiled.

// list<int>, list<float>, list<bool>: 8, 8 and 1 byte per element
let ints: list<int> = []
let floats: list<float> = []
let flags: list<bool> = []
for i in 0..30000 {
    ints.push(i % 7)
    floats.push(i)              // an int into a list of floats is converted
    floats.push(i * 0.5)
    flags.push(i % 3 == 0)
}
print(len(ints), len(floats), len(flags), typeof(ints), ints[3], floats[2], floats[3], flags[0], flags[1])

// reading by index (negative indexes too), and for-in
let a = 0
let b = 0.0
let c = 0
for i in 0..30000 {
    a = a + ints[i] + ints[-1]
    b = b + floats[i * 2 + 1]
    if flags[i] { c = c + 1 }
}
let d = 0
for x in ints { d = d + x }
let e = 0.0
for x in floats { e = e + x }
let f = 0
for x in flags { if x { f = f + 1 } }
print(a, b, c, d, e, f)

// the sized kinds: a u8 that fits is pushed by compiled code too
let bytes: list<u8> = []
let wide: list<i32> = []
let halves: list<f32> = []
for i in 0..30000 {
    bytes.push(i % 256)
    wide.push(i * 70000 - 1000000000)
    halves.push(i * 0.5)
}
let g = 0
for x in bytes { g = g + x }
let h = 0
for i in 0..30000 { h = h + wide[i] }
let k = 0.0
for x in halves { k = k + x }
print(len(bytes), g, h, k, bytes[255], bytes[256], wide[0], wide[-1])

// inside a function: the list comes as a parameter
fn sum(xs: list<int>): int {
    let t = 0
    for x in xs { t = t + x }
    for i in 0..len(xs) { t = t + xs[i] }
    return t
}
print(sum(ints), sum(bytes))

// they are lists: methods, printing, equality, JSON; storing is checked
import json from "fogu:json"
const few: list<bool> = [true, false, true]
const nums: list<int> = [3, 1, 2]
const reals: list<float> = [1, 2.5]
print(few, nums.sort(), reals, few == [true, false, true], json.stringify(few), json.stringify(reals))
print(nums.map((x) => x * 2), few.contains(false), reals.slice(1), typeof(reals[0]))

// a value the kind refuses stops the loop where the interpreter would:
// what was pushed before it stays, nothing after
let small: list<u8> = []
let pushed = 0
fn fill() {
    for i in 0..30000 {
        small.push(i % 300)
        pushed = pushed + 1
    }
}
fill()
