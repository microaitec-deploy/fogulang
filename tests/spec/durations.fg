// Durations (spec §7.7)
print(500ms, 2s, 5m, 1h, 1d, 1500ms, 90s, 250us, 10ns, 0s, 1.5s)
print(typeof(2s), 2s == 2000ms, 1m > 59s, 1s < 999ms)
print(1s + 500ms, 2m - 30s, 2s * 3, 3 * 2s, 10s / 4, 1s * 0.5, 1m / 2s, 7s % 2s, -3s)
const d = 1500ms
print(d.ns, d.us, d.ms, d.seconds, 90s.minutes, 30m.hours)
print(`waiting ${250ms}`)
import time from "fogu:time"
// measured with the monotonic clock: the wall clock (time.now) may be set
// back by the system while the test runs
const t0 = time.monotonic()
time.delay(20ms)
time.sleep(10ms)
print(time.monotonic() - t0 >= 0.03)
