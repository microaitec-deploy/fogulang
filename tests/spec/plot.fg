import plot from "fogu:plot"
import fs from "fogu:fs"

// ---------- charts ----------
const fig = plot.figure({ title: "Sales & <more>", xlabel: "month", ylabel: "€", width: 400, height: 240 })
fig.line([1, 2, 3], [10, 14, 9], { label: "2025", marker: true })
fig.bar(["a", "b"], [1, 2])
const svg = fig.svg()
print(svg.starts_with("<svg"), svg.contains("Sales &amp; &lt;more&gt;"), svg.contains("2025"), fig)
fig.save("chart.tmp.svg")?
fig.save("chart.tmp.png")?
print(fs.readText("chart.tmp.svg")? == svg, fs.stat("chart.tmp.png")?.size > 1000)
print(fig.image()?.width, fig.image({ scale: 2 })?.height)
print(plot.pie(["A", "B"], [3, 1], { donut: true }).svg().contains("75%"))
print(plot.hist([1, 2, 2, 3, 3, 3], { bins: 3 }).series, plot.line(0..5).series)
