import math from "fogu:math"

print(math.sin(0), math.cos(0), math.tan(0))
print(math.round(math.sin(math.PI / 2), 6), math.round(math.cos(math.PI), 6))
print(math.atan2(1, 1) == math.PI / 4, math.hypot(3, 4))
print(math.exp(0), math.log(math.E), math.log(8, 2), math.log2(1024), math.log10(1000))
print(math.cbrt(27), math.degrees(math.PI), math.radians(180) == math.PI)
print(math.round(2.5), math.round(-2.5), math.round(3.14159, 2), math.round(7))
print(math.trunc(-3.7), math.fract(2.25), math.sign(-4), math.sign(2.5), math.sign(0))
print(math.min(3, 1, 2), math.max(3, 1.5), math.min([4, 2, 8]), math.max(2, 7))
print(math.clamp(15, 0, 10), math.clamp(-1.5, 0, 1), math.lerp(0, 10, 0.25))
print(math.isNaN(math.NAN), math.isInf(math.INF), math.isFinite(1.0), math.isFinite(math.INF))
print(math.gcd(12, 18), math.lcm(4, 6), math.factorial(10), math.isPrime(97), math.isPrime(91))
print(math.sum([1, 2, 3]), math.sum([1, 2.5]), math.mean([1, 2, 3, 4]), math.median([5, 1, 3, 2]))
print(math.TAU == 2 * math.PI, math.MAX_INT, math.MIN_INT)

math.seed(42)
const a = [math.random(), math.randomInt(1, 6), math.uniform(5, 10)]
math.seed(42)
const b = [math.random(), math.randomInt(1, 6), math.uniform(5, 10)]
print(a == b, a[0] >= 0 && a[0] < 1, a[1] >= 1 && a[1] <= 6, a[2] >= 5 && a[2] < 10)
const xs = [1, 2, 3, 4, 5]
math.shuffle(xs)
print(xs.len(), math.sum(xs), [1, 2, 3].contains(math.choice([1, 2, 3])), math.choice([]))

// the same functions inside a hot loop (compiled by the JIT)
fn wave(n) {
    let s = 0.0
    let k = 0
    for i in 0..n {
        s = s + math.sin(i) * math.cos(i) + math.sqrt(i) - math.log(i + 1) + math.atan2(i, 3)
        k = k + math.max(i, 3) - math.min(i, 3) + math.round(i / 3.0) + math.trunc(i * 0.5)
    }
    return [math.round(s, 6), k]
}
print(wave(1000))
