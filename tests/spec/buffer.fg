// buffer: a mutable byte sequence (bytes(...))
const b = bytes("héllo")
print(typeof(b), b.len(), len(b), b[0], b[-1])
print(b.text(), b.hex(), b.base64())
print(b)
print(bytes(3), bytes(0))

// encodings
print(bytes("cafe", "hex").hex(), bytes("aGk=", "base64").text(), bytes("ÿ", "latin1")[0])
print(bytes([1, 2, 255]).toList(), bytes(b).equals(b), bytes(b) == b, bytes("a") == bytes("b"))

// mutation and growth
const m = bytes("ab")
m[0] = 65
m.push(67, 68).append("EF").append(bytes([71]))
print(m.text(), m.len())
print(m.slice(1, 3).text(), m.slice(-2).text(), m.indexOf("CD"), m.indexOf(70), m.includes("Z"))
print(m.startsWith("Ab"), m.endsWith(bytes("FG")), m.concat("!").text(), m.text())
const parts = bytes("a,b,,c").split(",")
print(parts.len(), parts[3].text(), parts[2].len())

// numbers: little-endian by default, big-endian with true
const n = bytes(16)
n.writeU16(0, 513)
n.writeI32(2, -2, true)
n.writeF64(8, 1.5)
print(n.readU16(0), n.readU16(0, true), n.readI32(2, true), n.readU8(2), n.readF64(8))
print(n.slice(0, 6).hex())

// iteration
let sum = 0
for x in bytes([1, 2, 3]) { sum = sum + x }
for i, x in bytes("hi") { print(i, x) }
print(sum)

// type annotations and errors
fn first(data: buffer): int { return data[0] }
print(first(bytes("Z")))
const z = bytes(1)
z[0] = 300
