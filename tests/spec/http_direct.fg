// The HTTP/1.1 server that runs on the interpreter thread (Linux, no TLS):
// pipelined requests, a chunked upload, HEAD, server-sent events, two
// listeners sharing a port and a request the client abandons.
import http from "fogu:http"
import web from "fogu:web"
import net from "fogu:net"
import time from "fogu:time"

fn serve() {
    const app = web.app()
    app.get("/a", (ctx) => "A")
    app.get("/b", (ctx) => ({ b: 2 }))
    app.post("/echo", (ctx) => ctx.body)
    app.get("/wait", (ctx) => { time.delay(150ms); return "waited" })
    app.get("/events", (ctx) => {
        const s = web.sse({ retry: 500 })
        fg fn() {
            for i in 0..3 {
                s.send({ n: i }, { event: "tick" })
                time.delay(5ms)
            }
            s.close()
        }()
        return s
    })
    app.listen(18531, { quiet: true, reusePort: true })?
}
// the kernel spreads the connections over the two listeners
serve()
serve()

fn raw(text, wait) {
    const c = net.tcpConnect("127.0.0.1:18531", 2s)?
    c.setTimeout(wait)
    c.write(text)?
    const got = c.readAll()
    c.close()
    if typeof(got) == "error" { return "error" }
    return got.text()
}

let done = false
fg fn() {
    // two requests in one write are answered in order on one connection
    const two = raw("GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", 2s)
    const parts = two.split("HTTP/1.1 ")
    print("pipelined", len(parts) - 1, two.contains("\r\n\r\nA"), two.ends_with("{\"b\":2}"))

    // a body sent in chunks
    const up = raw("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n4\r\ndefg\r\n0\r\n\r\n", 2s)
    print("chunked", up.split("\r\n")[0], up.ends_with("abcdefg"))

    // HEAD carries the length and no body
    const head = raw("HEAD /a HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", 2s)
    print("head", head.split("\r\n")[0], head.lower().contains("content-length: 1"), head.ends_with("\r\n\r\n"))

    // server-sent events
    const ev = http.stream("http://127.0.0.1:18531/events", { lines: true })?
    const data = []
    for line in ev { if line.starts_with("data:") { data.push(line) } }
    print("sse", ev.headers["content-type"], data)

    // both listeners answer
    let ok = 0
    for i in 0..16 {
        const r = http.get("http://127.0.0.1:18531/a")?
        if r.body == "A" { ok = ok + 1 }
    }
    print("shared port", ok)

    // handlers that wait do not hold each other up, and idle connections
    // are served while they wait
    const t0 = time.monotonic()
    let waited = 0
    let quick = 0
    for i in 0..8 {
        fg fn() {
            if http.get("http://127.0.0.1:18531/wait")?.body == "waited" { waited = waited + 1 }
        }()
    }
    time.delay(30ms)
    for i in 0..8 {
        if http.get("http://127.0.0.1:18531/a")?.body == "A" { quick = quick + 1 }
    }
    const quick_in = time.monotonic() - t0
    while waited < 8 { time.delay(5ms) }
    print("waiting handlers", waited, quick, quick_in < 0.14, time.monotonic() - t0 < 0.6)

    // a client that leaves in the middle of a request does not hurt the next one
    const gone = net.tcpConnect("127.0.0.1:18531", 2s)?
    gone.write("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 50\r\n\r\nhalf")?
    gone.close()
    print("after abandon", http.get("http://127.0.0.1:18531/a")?.body)
    done = true
}()
while !done { time.delay(10ms) }
