// fogu:kv — embedded key-value store (redb)
import kv from "fogu:kv"

const db = kv.open("kv.tmp.redb")?
db.clear()
db.set("name", "Fogu")
db.set("version", 3)
db.set("pi", 3.5)
db.set("active", true)
db.set("list", [1, "two", 3])
print(db.get("name"), db.get("version"), db.get("pi"), db.get("active"), db.get("list"))
print(db.has("name"), db.has("nothing"), db.get("nothing"))
print(db.keys(), db.len())
print(db.delete("pi"), db.delete("pi"))
print(db.len(), db.get("pi"))
// buffers and durations keep their type; lists keep their text exactly
db.set("buf", bytes([0, 1, 255]))
db.set("wait", 1500ms)
db.set("lines", ["a\nb", "q\"t", { k: [1, 2] }])
print(db.get("buf"), db.get("wait"), typeof(db.get("wait")))
const lines = db.get("lines")
print(lines[0] == "a\nb", lines[1], lines[2].k)
db.delete("buf")
db.delete("wait")
db.delete("lines")
db.close()

const other = kv.open("kv.tmp.redb")?
print("persisted:", other.get("name"))
other.close()
