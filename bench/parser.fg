// A program, not a kernel: generate 20k arithmetic expressions, tokenize them,
// parse them into trees (recursive descent, a Parser struct) and evaluate them.
// Strings, structs, maps and calls: the code the JIT does not compile.
const M = 1000003
let seed = 42
fn rnd(n) {
    seed = (seed * 75 + 74) % 65537
    return seed % n
}

const names = ["a", "b", "c", "d"]
fn gen(depth) {
    if depth == 0 || rnd(4) == 0 {
        if rnd(3) == 0 { return names[rnd(4)] }
        return str(rnd(100))
    }
    const op = ["+", "*"][rnd(2)]
    const left = gen(depth - 1)
    const right = gen(depth - 1)
    return "(" + left + " " + op + " " + right + ")"
}

fn tokenize(src) {
    const toks = []
    const cs = src.chars()
    const n = cs.len()
    let i = 0
    while i < n {
        const c = cs[i]
        const k = c.code()
        if k == 32 {
            i += 1
        } else if k >= 48 && k <= 57 {
            let v = 0
            while i < n && cs[i].code() >= 48 && cs[i].code() <= 57 {
                v = v * 10 + cs[i].code() - 48
                i += 1
            }
            toks.push({ kind: "num", value: v, text: "" })
        } else if k >= 97 && k <= 122 {
            toks.push({ kind: "id", value: 0, text: c })
            i += 1
        } else {
            toks.push({ kind: "op", value: 0, text: c })
            i += 1
        }
    }
    return toks
}

struct Parser {
    toks = []
    pos = 0
    new(toks) {
        this.toks = toks
        this.pos = 0
    }
    fn peek() {
        if this.pos < this.toks.len() { return this.toks[this.pos].text }
        return ""
    }
    fn expr() {
        let left = this.term()
        while this.peek() == "+" {
            this.pos += 1
            left = { op: "+", l: left, r: this.term() }
        }
        return left
    }
    fn term() {
        let left = this.factor()
        while this.peek() == "*" {
            this.pos += 1
            left = { op: "*", l: left, r: this.factor() }
        }
        return left
    }
    fn factor() {
        const t = this.toks[this.pos]
        this.pos += 1
        if t.kind == "num" { return { op: "num", value: t.value } }
        if t.kind == "id" { return { op: "id", name: t.text } }
        const e = this.expr()
        this.pos += 1 // ")"
        return e
    }
}

const env = { a: 3, b: 5, c: 7, d: 11 }
fn eval(node) {
    const op = node.op
    if op == "num" { return node.value }
    if op == "id" { return env[node.name] }
    const l = eval(node.l)
    const r = eval(node.r)
    if op == "+" { return (l + r) % M }
    return (l * r) % M
}

let sum = 0
let tokens = 0
for i in 0..20000 {
    const src = gen(6)
    const toks = tokenize(src)
    tokens += toks.len()
    const p = new Parser(toks)
    sum = (sum + eval(p.expr())) % M
}
print(sum, tokens)
