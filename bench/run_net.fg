// Servers and concurrency: Fogu vs Go vs Bun vs Python — HTTP throughput,
// WebSocket, TCP and UDP echo, memory per task, concurrent waits and message
// passing. Writes bench/results_net.json and bench/RESULTS_NET.md.
//
//   fogu bench/run_net.fg            // 3 rounds (the median is kept)
//   fogu bench/run_net.fg 5 http     // 5 rounds, only HTTP
//   FOGU_PREV=/path/to/older/fogu fogu bench/run_net.fg   // also measures that
//                                    // binary ("Fogu (previous)"): no release
//                                    // may be slower than the one before
//
// Needs Linux (servers are started with `sh -c`), go (the Go servers and the
// load generators of HTTP, TCP and UDP are bench/net/go, built into
// bench/.bin/netbench) and bun (the WebSocket load). A server that cannot
// start (Python without aiohttp or websockets, say) is skipped.
// $FOGU_BIN, $BUN_BIN, $PYTHON_BIN, $GO_BIN pick binaries.
import process from "fogu:process"
import fs from "fogu:fs"
import json from "fogu:json"
import http from "fogu:http"
import time from "fogu:time"
import system from "fogu:system"

const pick = fn(cond, yes, no) {
    if cond { return yes }
    return no
}

// the machine's load average (1 minute), recorded with the results
const loadavg = fn() {
    const [text, err] = fs.readText("/proc/loadavg")
    if err != nil { return nil }
    return float(text.split(" ")[0])
}
const loadStart = loadavg()
const dir = pick(fs.exists("bench/net/http.fg"), "bench/net", "net")
const fogu = Fogu.env["FOGU_BIN"] ?? pick(fs.exists("target/release/fogu"), "target/release/fogu", "fogu")
const bun = Fogu.env["BUN_BIN"] ?? "bun"
const python = Fogu.env["PYTHON_BIN"] ?? pick(fs.exists("bench/.venv/bin/python"), "bench/.venv/bin/python", "python3")
const prev = Fogu.env["FOGU_PREV"]
const go = Fogu.env["GO_BIN"] ?? "go"
const root = pick(dir == "net", ".", "bench")
const netbench = root + "/.bin/netbench"
{
    const r = process.run("sh", ["-c", "mkdir -p '" + root + "/.bin' && cd '" + dir + "/go' && GOWORK=off GOFLAGS=-mod=mod '" + go + "' build -o ../../.bin/netbench ."])?
    if !r.ok { print("could not build bench/net/go:", r.stderr) }
}
// Fogu, the previous Fogu (if given) and the rest, for a `<kind>.<ext>` server
const impls_of = fn(kind, others) {
    const out = [{ name: "Fogu", cmd: fogu, args: [dir + "/" + kind + ".fg"] }]
    if prev != nil { out.push({ name: "Fogu (previous)", cmd: prev, args: [dir + "/" + kind + ".fg"] }) }
    out.push({ name: "Go", cmd: netbench, args: [kind] })
    return out.concat(others)
}

let rounds = 3
let only = []
for a in Fogu.args {
    const n = json.parse(a)
    if typeof(n) == "int" { rounds = n } else { only.push(a) }
}
const want = (name) => only.len() == 0 || only.contains(name)

const median = fn(xs) {
    if xs.len() == 0 { return nil }
    const s = xs.sort()
    return s[s.len() / 2]
}

// a server in the background: its pid, once it prints "ready" and answers
let nextPort = 18800
const start = fn(cmd, args, probe) {
    nextPort = nextPort + 1
    const port = nextPort
    const log = "/tmp/fogu-bench-" + str(port) + ".log"
    // a script that takes more than the port gets it where "PORT_FIRST" stands
    const withPort = pick(args.contains("PORT_FIRST"), args.map((a) => pick(a == "PORT_FIRST", str(port), a)), args.concat([str(port)]))
    const line = ([cmd].concat(withPort)).map((a) => "'" + a + "'").join(" ")
    const r = process.run("sh", ["-c", line + " > " + log + " 2>&1 & echo $!"])?
    const pid = r.stdout.trim()
    const deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline {
        const [text, _] = fs.readText(log)
        if text != nil && text.contains("ready") {
            if probe == nil { return { pid: pid, port: port } }
            const [res, err] = http.get(probe.replace("PORT", str(port)), { timeout: 1s })
            if err == nil && res.status == 200 { return { pid: pid, port: port } }
        }
        time.delay(50ms)
    }
    process.run("kill", [pid])
    return nil, error("the server did not start: " + line)
}
const stop = fn(s) {
    process.run("kill", [s.pid])
    time.delay(300ms)
}

const results = { rounds: rounds }

// ---------- HTTP ----------
if want("http") {
    const impls = impls_of("http", [
        { name: "Bun", cmd: bun, args: [dir + "/http.js"] },
        { name: "Python (aiohttp)", cmd: python, args: ["-I", dir + "/http_aiohttp.py"] },
        { name: "Python (stdlib)", cmd: python, args: ["-I", dir + "/http.py"] },
    ])
    const data = {}
    for impl in impls { data[impl.name] = { rps: [], p50: [], p99: [], errors: 0 } }
    for round in 0..rounds {
        for impl in impls {
            const [s, serr] = start(impl.cmd, impl.args, "http://127.0.0.1:PORT/hello")
            if serr != nil { if round == 0 { print("http ·", impl.name, "· skipped (did not start)") }
                continue
            }
            const r = process.run(netbench, ["load-http", "http://127.0.0.1:" + str(s.port) + "/hello", "64", "5"])?
            stop(s)
            const j = json.parse(r.stdout.trim())
            if typeof(j) == "error" { print("load failed for", impl.name, r.stderr); continue }
            const d = data[impl.name]
            d.rps.push(j.count / j.seconds)
            d.p50.push(j.p50)
            d.p99.push(j.p99)
            d.errors = d.errors + j.errors
            print("http ·", impl.name, "·", str(int(j.count / j.seconds)), "req/s")
        }
    }
    results.http = impls.filter((i) => data[i.name].rps.len() > 0).map((i) => ({ name: i.name, rps: median(data[i.name].rps), p50: median(data[i.name].p50), p99: median(data[i.name].p99), errors: data[i.name].errors }))
}

// ---------- WebSocket ----------
if want("ws") {
    const impls = impls_of("ws", [
        { name: "Bun", cmd: bun, args: [dir + "/ws.js"] },
        { name: "Python (websockets)", cmd: python, args: ["-I", dir + "/ws.py"] },
    ])
    const data = {}
    for impl in impls { data[impl.name] = { mps: [], errors: 0 } }
    for round in 0..rounds {
        for impl in impls {
            const [s, serr] = start(impl.cmd, impl.args, nil)
            if serr != nil { if round == 0 { print("ws ·", impl.name, "· skipped (did not start)") }
                continue
            }
            time.delay(200ms)
            const r = process.run(bun, [dir + "/ws_load.js", "ws://127.0.0.1:" + str(s.port), "50", "5"])?
            stop(s)
            const j = json.parse(r.stdout.trim())
            if typeof(j) == "error" { print("ws load failed for", impl.name, r.stdout, r.stderr); continue }
            data[impl.name].mps.push(j.messages / j.seconds)
            data[impl.name].errors = data[impl.name].errors + j.errors
            print("ws ·", impl.name, "·", str(int(j.messages / j.seconds)), "msg/s")
        }
    }
    results.ws = impls.filter((i) => data[i.name].mps.len() > 0).map((i) => ({ name: i.name, mps: median(data[i.name].mps), errors: data[i.name].errors }))
}

// ---------- TCP and UDP echo: 64-byte messages ----------
// `conns` connections; TCP also with 256, where the cores matter: there Fogu
// runs one sync.Worker per core (bench/net/tcp_workers.fg, reusePort)
const echo = fn(kind, conns, multicore) {
    let impls = impls_of(kind, [
        { name: "Bun", cmd: bun, args: [dir + "/" + kind + ".js"] },
        { name: "Python (asyncio)", cmd: python, args: ["-I", dir + "/" + kind + ".py"] },
    ])
    if multicore {
        const half = str(int(system.info.cores / 2))
        impls = [{ name: "Fogu (workers)", cmd: fogu, args: [dir + "/tcp_workers.fg", "PORT_FIRST", half] }].concat(impls)
    }
    const data = {}
    for impl in impls { data[impl.name] = { mps: [], p50: [], p99: [], errors: 0 } }
    for round in 0..rounds {
        for impl in impls {
            const [s, serr] = start(impl.cmd, impl.args, nil)
            if serr != nil { if round == 0 { print(kind, "·", impl.name, "· skipped (did not start)") }
                continue
            }
            time.delay(200ms)
            const r = process.run(netbench, ["load-" + kind, "127.0.0.1:" + str(s.port), str(conns), "5"])?
            stop(s)
            const j = json.parse(r.stdout.trim())
            if typeof(j) == "error" { print(kind, "load failed for", impl.name, r.stderr); continue }
            const d = data[impl.name]
            d.mps.push(j.count / j.seconds)
            d.p50.push(j.p50)
            d.p99.push(j.p99)
            d.errors = d.errors + j.errors
            print(kind, "·", impl.name, "·", str(int(j.count / j.seconds)), "msg/s")
        }
    }
    return impls.filter((i) => data[i.name].mps.len() > 0).map((i) => ({ name: i.name, mps: median(data[i.name].mps), p50: median(data[i.name].p50), p99: median(data[i.name].p99), errors: data[i.name].errors }))
}
if want("tcp") { results.tcp = echo("tcp", 64, false) }
if want("tcp256") { results.tcp256 = echo("tcp", 256, true) }
if want("udp") { results.udp = echo("udp", 64, false) }

// ---------- tasks: memory, concurrent waits, message passing ----------
const langs = [
    { name: "Fogu", cmd: fogu, args: [], ext: "fg" },
    { name: "Python", cmd: python, args: ["-I"], ext: "py" },
    { name: "Bun", cmd: bun, args: [], ext: "js" },
]
// peak memory (KB) of `prog n`, through /usr/bin/time
const peak = fn(l, n) {
    const r = process.run("/usr/bin/time", ["-f", "%M"].concat([l.cmd]).concat(l.args).concat([dir + "/tasks." + l.ext, str(n)]))?
    if !r.ok { return nil, error(r.stderr.trim()) }
    return int(r.stderr.trim().split("\n")[-1]), nil
}
const TASKS = 20000
if want("tasks") {
    const per = {}
    for l in langs { per[l.name] = [] }
    for round in 0..rounds {
        for l in langs {
            const base = peak(l, 0)?
            const full = peak(l, TASKS)?
            per[l.name].push((full - base) * 1024 / TASKS)
            print("tasks ·", l.name, "·", str((full - base) * 1024 / TASKS), "bytes per task")
        }
    }
    results.tasks = { count: TASKS, perTask: langs.map((l) => ({ name: l.name, bytes: median(per[l.name]) })) }
}

const timed = fn(name) {
    const per = {}
    for l in langs { per[l.name] = [] }
    for round in 0..rounds {
        for l in langs {
            const t0 = time.monotonic()
            const r = process.run(l.cmd, l.args.concat([dir + "/" + name + "." + l.ext]))?
            if !r.ok { print(name, "failed for", l.name, r.stderr) ; continue }
            per[l.name].push((time.monotonic() - t0) * 1000)
        }
    }
    const out = langs.map((l) => ({ name: l.name, ms: median(per[l.name]) }))
    for o in out { print(name, "·", o.name, "·", str(int(o.ms ?? 0)), "ms") }
    return out
}
if want("sleeps") { results.sleeps = timed("sleeps") }
if want("pingpong") { results.pingpong = timed("pingpong") }

const versions = fn(cmd, args) {
    const [r, err] = process.run(cmd, args)
    if err != nil { return "?" }
    return (r.stdout + r.stderr).trim().split("\n")[0]
}
results.date = time.now()
results.versions = {
    Fogu: "fogu " + Fogu.version,
    Python: versions(python, ["--version"]),
    Bun: "bun " + versions(bun, ["--version"]),
    Go: versions(go, ["version"]),
}
results.cores = system.info.cores
results.load = [loadStart, loadavg()]
// a partial run (`run_net.fg 5 tasks`) keeps the other sections of the previous results
const outFile = pick(dir == "net", "results_net.json", "bench/results_net.json")
if only.len() > 0 && fs.exists(outFile) {
    const old = json.parse(fs.readText(outFile)?)
    if typeof(old) == "map" {
        for k in ["http", "ws", "tcp", "tcp256", "udp", "tasks", "sleeps", "pingpong"] {
            if results[k] == nil && old[k] != nil { results[k] = old[k] }
        }
    }
}
fs.writeText(outFile, json.stringify(results) + "\n")?

// the same as a page
const cpu = fn() {
    const [text, err] = fs.readText("/proc/cpuinfo")
    if err != nil { return system.info.os + " " + system.info.arch }
    for line in text.split("\n") {
        if line.starts_with("model name") { return line.split(":")[1].trim() }
    }
    return system.info.os + " " + system.info.arch
}
const md = ["# Fogu networking: servers and tasks", "",
    cpu() + " · " + str(results.cores) + " cores · median of " + str(rounds) + " rounds · " + results.versions.Fogu, ""]
const table = fn(title, note, rows, cols) {
    if rows == nil { return }
    md.push("## " + title)
    md.push("")
    md.push(note)
    md.push("")
    md.push("| | " + cols.map((c) => c[0]).join(" | ") + " |")
    md.push("|---|" + cols.map((c) => "---:").join("|") + "|")
    for r in rows {
        md.push("| " + r.name + " | " + cols.map((c) => c[1](r)).join(" | ") + " |")
    }
    md.push("")
}
const whole = (x) => str(int(x ?? 0))
const ms2 = (x) => str(int((x ?? 0) * 100) / 100.0)
table("HTTP", "`GET /hello` (a small JSON body), 64 keep-alive connections, 5 s.", results.http,
    [["requests/s", (r) => whole(r.rps)], ["p50 ms", (r) => ms2(r.p50)], ["p99 ms", (r) => ms2(r.p99)], ["errors", (r) => str(r.errors)]])
table("WebSocket echo", "50 connections, each sends a message and waits for its echo, 5 s.", results.ws,
    [["messages/s", (r) => whole(r.mps)], ["errors", (r) => str(r.errors)]])
table("TCP echo", "64 connections, 64-byte messages, each waits for its echo, 5 s.", results.tcp,
    [["messages/s", (r) => whole(r.mps)], ["p50 ms", (r) => ms2(r.p50)], ["p99 ms", (r) => ms2(r.p99)], ["errors", (r) => str(r.errors)]])
table("TCP echo, 256 connections", "256 connections, 64-byte messages, 5 s. Fogu also with one sync.Worker per core (reusePort): `bench/net/tcp_workers.fg`.", results.tcp256,
    [["messages/s", (r) => whole(r.mps)], ["p50 ms", (r) => ms2(r.p50)], ["p99 ms", (r) => ms2(r.p99)], ["errors", (r) => str(r.errors)]])
table("UDP echo", "64 sockets, 64-byte datagrams, each waits for its echo, 5 s.", results.udp,
    [["messages/s", (r) => whole(r.mps)], ["p50 ms", (r) => ms2(r.p50)], ["p99 ms", (r) => ms2(r.p99)], ["errors", (r) => str(r.errors)]])
if results.tasks != nil {
    table("Memory per task", str(results.tasks.count) + " sleeping tasks.", results.tasks.perTask, [["bytes", (r) => whole(r.bytes)]])
}
table("Concurrent waits", "`sleeps`: tasks that wait at the same time.", results.sleeps, [["ms", (r) => whole(r.ms)]])
table("Message passing", "`pingpong`: two tasks exchanging messages.", results.pingpong, [["ms", (r) => whole(r.ms)]])
fs.writeText(pick(dir == "net", "RESULTS_NET.md", "bench/RESULTS_NET.md"), md.join("\n"))?
print("wrote results_net.json and RESULTS_NET.md")
